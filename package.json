{
  "name": "backend-challenge-solution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ./src/server/start.ts",
    "build": "tsc ./src -d dist --strip-leading-paths",
    "deploy": "serverless deploy",
    "lint": "lint",
    "test": "vitest",
    "test:single": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check-types": "tsc --noEmit",
    "prepare": "husky",
    "depcruise:validate": "depcruise --config .dependency-cruiser.cjs src",
    "find-circular-deps": "madge ./src/ -c",
    "test:owasp": "owasp-dependency-check --project \"node-challenge\" -f HTML JSON --nvdApiKey b27c4434-10e7-43f8-b9d5-838e8ec36a57 -s './src/**/*' --exclude node_modules --exclude 'src/test*/**/*'"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^1.2.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "db-local": "^3.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^11.0.0",
    "helmet": "^8.0.0",
    "http-status": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.11.0",
    "node-dependency-injection": "^3.2.2",
    "serverless-http": "^3.2.0",
    "uuid": "^11.0.3",
    "uuid-validate": "^0.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@codelytv/primitives-type": "^1.1.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/format": "^19.5.0",
    "@commitlint/prompt-cli": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.0",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/supertest": "^6.0.2",
    "@types/uuid-validate": "^0.0.3",
    "@typescript-eslint/parser": "^8.17.0",
    "dependency-cruiser": "^16.7.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "owasp-dependency-check": "^0.0.24",
    "serverless-offline": "^14.3.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
